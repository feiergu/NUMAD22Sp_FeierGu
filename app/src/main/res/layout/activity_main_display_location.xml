<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity_displayLocation">

    <TextView
        android:id="@+id/textView_latitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="120dp"
        android:text="@string/textView_latitude"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/textView_latitude_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView_longitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="45dp"
        android:text="@string/textView_longitude"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/textView_longitude_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_latitude" />

    <TextView
        android:id="@+id/textView_latitude_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="120dp"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/textView_latitude"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView_longitude_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginTop="32dp"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/textView_longitude"
        app:layout_constraintTop_toBottomOf="@+id/textView_latitude_content" />

</androidx.constraintlayout.widget.ConstraintLayout>